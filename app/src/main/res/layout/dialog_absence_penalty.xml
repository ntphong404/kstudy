<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp">

    <!-- The comma is allowed next to the point: it is the decimal mark people type in Vietnam -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAbsencePenalty"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số điểm trừ cho mỗi buổi vắng"
        app:helperText="Từ 0 đến 10, ví dụ 1 hoặc 0,5">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAbsencePenalty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789.,"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
