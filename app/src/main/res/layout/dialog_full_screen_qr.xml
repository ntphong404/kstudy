<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in a plain full-screen dialog without the app theme, so colours and sizes are literal.
     Dark on purpose: the screen is projected or held up for the whole room to scan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:gravity="center_horizontal"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnDismissDialog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="Mã QR điểm danh"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- Everything below is centred in the space left under the title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- White frame: the quiet zone a scanner needs around the code -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <vn.edu.actvn.kstudy.ui.common.QrView
                android:id="@+id/dialogQrView"
                android:layout_width="280dp"
                android:layout_height="280dp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Mã xác thực thủ công"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />

        <!-- Large on purpose: it is read from the back of the room -->
        <TextView
            android:id="@+id/dialogTvCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:textColor="@color/white"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/dialogTvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Phóng to để học sinh ngồi xa bảng vẫn quét được dễ dàng"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
