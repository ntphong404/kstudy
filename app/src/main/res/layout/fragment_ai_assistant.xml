<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.Kstudy.AppBar">

        <!-- Only shown when the screen was opened on top of another one -->
        <ImageView
            android:id="@+id/btnBackAi"
            style="@style/Widget.Kstudy.AppBar.BackButton"
            android:contentDescription="Quay lại"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trợ lý AI"
                android:textAppearance="@style/TextAppearance.Kstudy.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hỏi đáp chuyên cần"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearChat"
            style="@style/Widget.Kstudy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-12dp"
            android:text="Làm mới" />
    </LinearLayout>

    <!-- Conversation -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvAiTyping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="8dp"
        android:text="Trợ lý đang trả lời…"
        android:textAppearance="@style/TextAppearance.Kstudy.Caption"
        android:visibility="gone" />

    <!-- Suggested questions -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutAiSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="12dp">

        <EditText
            android:id="@+id/etAiMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="Nhập câu hỏi về điểm danh…"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="@style/TextAppearance.Kstudy.Body"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnSendAi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_button"
            android:contentDescription="Gửi"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            app:tint="?attr/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
