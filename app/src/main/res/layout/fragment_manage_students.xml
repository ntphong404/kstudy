<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/studentsHeader"
        style="@style/Widget.Kstudy.AppBar">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Danh sách học sinh"
            android:textAppearance="@style/TextAppearance.Kstudy.Title" />

        <Button
            android:id="@+id/btnAddStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSearchStudent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Tìm kiếm tên, MSSV hoặc lớp..."
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textAppearance="@style/TextAppearance.Kstudy.Body"
        android:textColorHint="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStudents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="16dp" />

        <include layout="@layout/view_list_state" />
    </FrameLayout>
</LinearLayout>
