<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.Kstudy.AppBar">

        <ImageView
            android:id="@+id/btnBackStudentDetail"
            style="@style/Widget.Kstudy.AppBar.BackButton"
            android:contentDescription="Quay lại" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentDetailSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Kstudy.Title" />

            <TextView
                android:id="@+id/tvStudentDetailClassInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginTop="8dp"
                android:text="Thông tin chuyên cần" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvStudentDetailRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đi học"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>

                <View style="@style/Widget.Kstudy.Stat.Divider" />

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvStudentDetailPresentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Có mặt"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>

                <View style="@style/Widget.Kstudy.Stat.Divider" />

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvStudentDetailAbsentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vắng mặt"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Leave requests -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đơn xin nghỉ phép"
                    android:textAppearance="@style/TextAppearance.Kstudy.Section" />

                <Button
                    android:id="@+id/btnRequestLeave"
                    style="@style/Widget.Kstudy.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xin nghỉ phép" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStudentLeaveRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginTop="16dp"
                android:text="Lịch sử điểm danh" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudentClassHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Shown instead of the list while it has no records -->
            <TextView
                android:id="@+id/tvStudentClassHistoryEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có buổi điểm danh nào."
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
