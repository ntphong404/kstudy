<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The greeting, with the notification bell at the end of the line -->
        <LinearLayout
            style="@style/Widget.Kstudy.PageHeader"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStudentDashboardWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kstudy.Title" />

                <TextView
                    android:id="@+id/tvStudentDashboardSubDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
            </LinearLayout>

            <include layout="@layout/view_notification_bell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvStudentStatClasses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lớp đang học"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>

                <View style="@style/Widget.Kstudy.Stat.Divider" />

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvStudentStatAttendance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tỷ lệ điểm danh TB"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Attendance warnings, one banner per class at risk (empty when the student is doing fine) -->
            <LinearLayout
                android:id="@+id/layoutStudentWarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Lớp học sắp tới" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStudentUpcomingClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kstudy.ItemTitle" />

                <TextView
                    android:id="@+id/tvStudentUpcomingClassInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

                <LinearLayout style="@style/Widget.Kstudy.CardActions">

                    <Button
                        android:id="@+id/btnStudentTimetable"
                        style="@style/Widget.Kstudy.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem thời khóa biểu" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Chuyên cần của tôi" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <vn.edu.actvn.kstudy.ui.common.DonutChartView
                        android:id="@+id/chartStudentAttendance"
                        android:layout_width="112dp"
                        android:layout_height="112dp" />

                    <include
                        android:id="@+id/legendStudentAttendance"
                        layout="@layout/view_attendance_legend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStudentChartNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Đang tải dữ liệu…"
                    android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
            </LinearLayout>

            <!-- Attendance score out of 10, one line per class; filled in by the fragment -->
            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Điểm chuyên cần" />

            <LinearLayout
                android:id="@+id/layoutStudentScores"
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
