<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutStudentHeader"
        style="@style/Widget.Kstudy.AppBar">

        <ImageView
            android:id="@+id/btnBackStudentScan"
            style="@style/Widget.Kstudy.AppBar.BackButton"
            android:contentDescription="Quay lại" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điểm danh lớp học"
                android:textAppearance="@style/TextAppearance.Kstudy.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quét mã điểm danh"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Way 1: scan the teacher's QR code with the camera -->
            <Button
                android:id="@+id/btnStartCameraScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mở camera quét"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart" />

            <!-- Way 2: type the code shown next to the QR -->
            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginBottom="12dp"
                android:text="Hoặc nhập mã điểm danh thủ công" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mã điểm danh"
                app:helperText="Nhập mã 6 ký tự đang hiển thị">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etScanCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="10"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnSubmitScanCode"
                style="@style/Widget.Kstudy.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Xác nhận điểm danh" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
