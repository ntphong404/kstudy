<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.Kstudy.AppBar">

        <ImageView
            android:id="@+id/btnBackClassDetail"
            style="@style/Widget.Kstudy.AppBar.BackButton"
            android:contentDescription="Quay lại" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Kstudy.Title" />

            <TextView
                android:id="@+id/tvDetailClassInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginTop="8dp"
                android:text="Phiên điểm danh" />

            <!-- Case A: No Active Session -->
            <LinearLayout
                android:id="@+id/layoutNoActiveSession"
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có phiên điểm danh nào đang mở"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />

                <TextView
                    android:id="@+id/tvScheduleHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

                <Button
                    android:id="@+id/btnCreateSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mở điểm danh (QR/mã)" />
            </LinearLayout>

            <!-- Case B: Active Session Ongoing -->
            <LinearLayout
                android:id="@+id/layoutActiveSession"
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_legend_dot"
                        android:backgroundTint="@color/present" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Phiên điểm danh đang hoạt động"
                        android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenActiveSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Vào phiên điểm danh (QR/thủ công)" />
            </LinearLayout>

            <!-- Statistics, AI analysis and Excel export -->
            <LinearLayout
                android:id="@+id/btnOpenClassStats"
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chart"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thống kê &amp; báo cáo"
                        android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Biểu đồ, cảnh báo cấm thi, nhận xét AI, xuất Excel"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOutline" />
            </LinearLayout>

            <!-- Leave requests of this class, the ones waiting for a decision first -->
            <TextView
                android:id="@+id/tvLeaveRequestsTitle"
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Đơn xin nghỉ phép" />

            <LinearLayout
                android:id="@+id/layoutLeaveRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Attendance History Section (collapsible) -->
            <LinearLayout
                android:id="@+id/layoutSessionHistoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lịch sử điểm danh"
                    android:textAppearance="@style/TextAppearance.Kstudy.Section" />

                <ImageView
                    android:id="@+id/ivSessionHistoryToggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:rotation="-90"
                    android:src="@drawable/ic_expand_more"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSessionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginTop="16dp"
                android:text="Danh sách lớp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvClassDetailStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
