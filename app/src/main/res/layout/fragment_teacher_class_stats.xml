<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.Kstudy.AppBar">

        <ImageView
            android:id="@+id/btnBackClassStats"
            style="@style/Widget.Kstudy.AppBar.BackButton"
            android:contentDescription="Quay lại" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatsClassName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Kstudy.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thống kê &amp; báo cáo"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- Overall attendance -->
            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginTop="8dp"
                android:text="Tổng quan chuyên cần" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <vn.edu.actvn.kstudy.ui.common.DonutChartView
                        android:id="@+id/chartClassOverall"
                        android:layout_width="112dp"
                        android:layout_height="112dp" />

                    <include
                        android:id="@+id/legendClassOverall"
                        layout="@layout/view_attendance_legend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Đang tải dữ liệu…"
                    android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
            </LinearLayout>

            <!-- Attendance rate per session -->
            <TextView
                android:id="@+id/tvStatsBarTitle"
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Tỷ lệ đi học theo buổi" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <vn.edu.actvn.kstudy.ui.common.BarChartView
                    android:id="@+id/chartClassSessions"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>

            <!-- Students at risk -->
            <TextView
                android:id="@+id/tvStatsRiskTitle"
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Học sinh cần lưu ý" />

            <LinearLayout
                android:id="@+id/layoutStatsRisk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- AI analysis -->
            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:layout_marginTop="16dp"
                android:text="Nhận xét từ AI" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAiAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Để AI đọc số liệu điểm danh của lớp và viết nhận xét: xu hướng đi học, học sinh cần nhắc nhở và đề xuất cho giáo viên."
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pbAiAnalysis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnAiAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="Phân tích bằng AI" />
            </LinearLayout>

            <!-- Excel export -->
            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Báo cáo" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xuất bảng điểm danh của cả lớp ra file Excel (.xlsx) để lưu trữ hoặc gửi qua Zalo, email."
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

                <Button
                    android:id="@+id/btnExportExcel"
                    style="@style/Widget.Kstudy.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="Xuất báo cáo Excel" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
