<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The greeting, with the notification bell at the end of the line -->
        <LinearLayout
            style="@style/Widget.Kstudy.PageHeader"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTeacherDashboardWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kstudy.Title" />

                <TextView
                    android:id="@+id/tvTeacherDashboardSubDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
            </LinearLayout>

            <include layout="@layout/view_notification_bell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvTeacherStatClasses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lớp đang giảng dạy"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>

                <View style="@style/Widget.Kstudy.Stat.Divider" />

                <LinearLayout style="@style/Widget.Kstudy.Stat">

                    <TextView
                        android:id="@+id/tvTeacherStatStudents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng số học sinh"
                        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.Kstudy.SectionHeader"
                android:text="Lớp học sắp tới" />

            <LinearLayout
                style="@style/Widget.Kstudy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTeacherUpcomingClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kstudy.ItemTitle" />

                <TextView
                    android:id="@+id/tvTeacherUpcomingClassInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

                <LinearLayout style="@style/Widget.Kstudy.CardActions">

                    <Button
                        android:id="@+id/btnTeacherTimetable"
                        style="@style/Widget.Kstudy.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem thời khóa biểu" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
