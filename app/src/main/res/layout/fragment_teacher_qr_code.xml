<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <LinearLayout style="@style/Widget.Kstudy.AppBar">

        <ImageView
            android:id="@+id/btnBackQrCode"
            style="@style/Widget.Kstudy.AppBar.BackButton"
            android:contentDescription="Quay lại" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQrClassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Kstudy.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phiên điểm danh"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding">

        <!-- The rotating code: QR for scanning, text for typing -->
        <LinearLayout
            android:id="@+id/layoutQrCodeCard"
            style="@style/Widget.Kstudy.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <vn.edu.actvn.kstudy.ui.common.QrView
                android:id="@+id/qrView"
                android:layout_width="104dp"
                android:layout_height="104dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mã xác thực thủ công"
                    android:textAppearance="@style/TextAppearance.Kstudy.Caption" />

                <TextView
                    android:id="@+id/tvManualCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textAppearance="@style/TextAppearance.Kstudy.Headline" />

                <TextView
                    android:id="@+id/tvQrCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kstudy.Caption" />

                <Button
                    android:id="@+id/btnZoomQr"
                    style="@style/Widget.Kstudy.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Phóng to mã QR" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress of the check-in and the rules this session applies -->
        <LinearLayout
            style="@style/Widget.Kstudy.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQrStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã điểm danh: -- / -- học sinh"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pbQrProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:trackCornerRadius="2dp" />

            <!-- Which checks this session applies: location radius and late threshold -->
            <TextView
                android:id="@+id/tvQrRules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
        </LinearLayout>

        <TextView
            style="@style/Widget.Kstudy.SectionHeader"
            android:layout_marginTop="16dp"
            android:text="Danh sách điểm danh thủ công" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQrManualAttendance"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <View style="@style/Widget.Kstudy.Divider" />

    <!-- Action pinned under the list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btnEndSession"
            style="@style/Widget.Kstudy.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chốt danh sách &amp; đóng phiên" />
    </LinearLayout>
</LinearLayout>
