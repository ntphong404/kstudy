<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Kstudy.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecordStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />

        <TextView
            android:id="@+id/tvRecordStudentCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Kstudy.Caption" />

        <TextView
            android:id="@+id/tvRecordTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStatusPresent"
            style="@style/Widget.Kstudy.Button.Status"
            android:layout_marginEnd="4dp"
            android:text="Có" />

        <Button
            android:id="@+id/btnStatusLate"
            style="@style/Widget.Kstudy.Button.Status"
            android:layout_marginEnd="4dp"
            android:text="Trễ" />

        <Button
            android:id="@+id/btnStatusAbsent"
            style="@style/Widget.Kstudy.Button.Status"
            android:layout_marginEnd="4dp"
            android:text="Vắng" />

        <Button
            android:id="@+id/btnStatusExcused"
            style="@style/Widget.Kstudy.Button.Status"
            android:text="Phép" />
    </LinearLayout>
</LinearLayout>
