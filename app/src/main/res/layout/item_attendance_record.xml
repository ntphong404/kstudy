<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecordStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecordStudentCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRecordTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Four buttons have to fit next to the name on a narrow phone, hence 46dp each -->
        <Button
            android:id="@+id/btnStatusPresent"
            style="@style/Widget.Material3.Button"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:layout_marginEnd="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Có"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStatusLate"
            style="@style/Widget.Material3.Button"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:layout_marginEnd="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Trễ"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStatusAbsent"
            style="@style/Widget.Material3.Button"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:layout_marginEnd="3dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Vắng"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStatusExcused"
            style="@style/Widget.Material3.Button"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Phép"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
