<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Kstudy.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLeaveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />

        <TextView
            android:id="@+id/tvLeaveStatus"
            style="@style/Widget.Kstudy.StatusTag"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLeaveDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Kstudy.Caption" />

    <TextView
        android:id="@+id/tvLeaveReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

    <!-- Only shown to the teacher while the request is waiting for a decision -->
    <LinearLayout
        android:id="@+id/layoutLeaveActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnLeaveReject"
            style="@style/Widget.Kstudy.Button.Text.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Từ chối" />

        <Button
            android:id="@+id/btnLeaveApprove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duyệt" />
    </LinearLayout>
</LinearLayout>
