<?xml version="1.0" encoding="utf-8"?>
<!-- One read-only line of the profile: what it is on the left, its value on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvProfileInfoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

    <TextView
        android:id="@+id/tvProfileInfoValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Kstudy.Body" />
</LinearLayout>
