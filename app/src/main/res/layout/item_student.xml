<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Kstudy.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStudentInitials"
            style="@style/Widget.Kstudy.Avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Kstudy.ItemTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStudentCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

                <TextView
                    android:id="@+id/tvStudentClass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStudentPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden when the list is read-only, as in the roster a teacher sees -->
    <LinearLayout
        android:id="@+id/layoutStudentActions"
        style="@style/Widget.Kstudy.CardActions"
        android:visibility="gone">

        <Button
            android:id="@+id/btnDeleteStudent"
            style="@style/Widget.Kstudy.Button.Text.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEditStudent"
            style="@style/Widget.Kstudy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnActionStudent"
            style="@style/Widget.Kstudy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
