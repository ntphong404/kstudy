<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Kstudy.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInitials"
            style="@style/Widget.Kstudy.Avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTeacherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Kstudy.ItemTitle" />

            <TextView
                android:id="@+id/tvTeacherSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />

            <TextView
                android:id="@+id/tvTeacherPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Kstudy.Body.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/Widget.Kstudy.CardActions">

        <Button
            android:id="@+id/btnDeleteTeacher"
            style="@style/Widget.Kstudy.Button.Text.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa" />

        <Button
            android:id="@+id/btnResetTeacherPassword"
            style="@style/Widget.Kstudy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đặt lại mật khẩu" />

        <Button
            android:id="@+id/btnEditTeacher"
            style="@style/Widget.Kstudy.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa" />
    </LinearLayout>
</LinearLayout>
