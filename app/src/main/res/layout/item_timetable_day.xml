<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the timetable grid: the day, then one cell per time slot added by TimetableFragment -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="@dimen/timetable_day_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvTimetableDayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Kstudy.Body.Strong" />

        <TextView
            android:id="@+id/tvTimetableDayDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Kstudy.Caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTimetableCells"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingEnd="4dp" />
</LinearLayout>
