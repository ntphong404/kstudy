<?xml version="1.0" encoding="utf-8"?>
<!-- A lesson inside a cell of the timetable grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/bg_timetable_lesson"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/tvLessonName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textAppearance="@style/TextAppearance.Kstudy.Label"
        android:textColor="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/tvLessonRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Kstudy.Caption"
        android:textColor="?attr/colorOnPrimaryContainer" />
</LinearLayout>
