<?xml version="1.0" encoding="utf-8"?>
<!-- The bell in the header of a dashboard, with the number of unread notifications; wired by NotificationBell -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btnNotifications"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginEnd="-12dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="Thông báo"
    android:focusable="true">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_notifications"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvNotificationBadge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minWidth="18dp"
        android:paddingHorizontal="4dp"
        android:textAppearance="@style/TextAppearance.Kstudy.Caption"
        android:textColor="?attr/colorOnError"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
